# =============================================================================
# AI Infinite Session — environment template
# =============================================================================
# Copy this file to `.env` and fill in the values that match your local
# setup.  The application reads these via `apps/api/app/config.py` and
# `docker-compose.yml`.  All variables are optional; the defaults baked
# into the code will work for a single-user Docker run.
# =============================================================================


# ---- Web (Next.js) -----------------------------------------------------------

# Where the web app can reach the API.  Defaults to
# http://localhost:8000 in development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Disable Next.js telemetry (recommended for CI / containers).
NEXT_TELEMETRY_DISABLED=1


# ---- API (FastAPI) -----------------------------------------------------------

# 0 = development (uvicorn reload, verbose logs)
# 1 = production
APP_ENV=1

# 0.0.0.0 to expose the API outside the container.
API_HOST=0.0.0.0
API_PORT=8000

# SQLite database location.  Bind-mounted under ./data by default.
APP_DB_PATH=/app/data/app.db

# Transcript / memory files.  Bind-mounted under ./data by default.
APP_DATA_DIR=/app/data

# Set to 1 to enable LanceDB semantic retrieval.  Without it, the
# orchestrator falls back to keyword-only search.
APP_ENABLE_VECTOR=1

# 0 = disable the self-evolution runner (recommended in production).
APP_EVOLUTION_ENABLED=0


# ---- Auto web search ---------------------------------------------------------

# Default policy: "off" | "auto" | "always".
AUTO_SEARCH_POLICY=auto

# Cache TTL in seconds.  Set to 0 to disable the local cache.
AUTO_SEARCH_CACHE_TTL_SEC=900

# Max citations the model sees in the per-turn "grounded block".
AUTO_SEARCH_MAX_CITATIONS=5

# Max chars per snippet quoted in the grounded block.
AUTO_SEARCH_SNIPPET_CHARS=320

# Per-engine timeout (seconds) when calling the bundled
# `mcp/web-search-mcp` server.
NATIVE_WEB_SEARCH_TIMEOUT_SEC=45

# Set to 1 to prefer the in-process `direct_search.py` fallback
# (Bing HTML / Wikipedia REST / arXiv / Startpage) over the
# `native-web-search` MCP.  Useful when the MCP backend is blocked
# or rate-limited.
AUTO_SEARCH_PREFER_DIRECT=1


# ---- LLM provider ------------------------------------------------------------

# OpenAI-compatible base URL.  Examples:
#   https://api.openai.com/v1
#   http://localhost:1234/v1            (local LM Studio / llama.cpp)
#   http://ollama.local:11434/v1         (Ollama)
LLM_BASE_URL=http://localhost:1234/v1

# API key for the provider above.  Not required for local servers.
LLM_API_KEY=

# Default model id.  See Settings in the web UI for the full list.
LLM_MODEL=

# Context window size (tokens) for the model above.
LLM_CONTEXT_WINDOW=10000


# ---- MCP servers (JSON list) -------------------------------------------------

# Optional: a JSON list of MCP servers to register at startup.
# Example:
# MCP_SERVERS_JSON=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/absolute/path"]}]


# ---- Logging -----------------------------------------------------------------

# Log level for the API.  DEBUG / INFO / WARNING / ERROR.
APP_LOG_LEVEL=INFO
